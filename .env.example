# =============================================================================
# Environment shape for this project (ADR 0004).
#
# Copy the DEVELOPMENT block into a local, gitignored `.env` for `pnpm dev`.
# The PRODUCTION block is set as Vercel project environment variables
# (Production scope) — it never lives in this repo.
# =============================================================================

# -----------------------------------------------------------------------------
# DEVELOPMENT  (local `.env`, gitignored)
# -----------------------------------------------------------------------------
# Dev runs entirely against an isolated local SQLite file in push mode. It must
# NOT carry production database or blob tokens — that isolation is the whole
# point of the dev/prod split.

# Local SQLite sandbox. Created/synced automatically on `pnpm dev`.
DATABASE_URL=file:./dev.db

# Development-only secret (any random string). Must NOT equal the prod secret.
PAYLOAD_SECRET=replace-with-a-random-dev-secret

# Local URL. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Dev-only secrets (do not reuse production values).
CRON_SECRET=replace-with-a-random-dev-secret
PREVIEW_SECRET=replace-with-a-random-dev-secret

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Production Turso database name (for db:pull)
PROD_TURSO_DATABASE_NAME=virgil-bakery-web-prod

# Production site public URL, no trailing slash (for media:pull — fetches
# media binaries absent from local public/media back from prod).
PROD_SITE_URL=https://painecumaiabyvirgil.ro

# In development, DO NOT set these (their absence keeps dev isolated):
#   DATABASE_AUTH_TOKEN   — production Turso auth token
#   BLOB_READ_WRITE_TOKEN — production Vercel Blob token
#   BLOB_STORE_ID         — production Vercel Blob store id
# Local uploads instead write to public/media; production images still render
# via their public blob URLs (see next.config.ts remotePatterns).

# -----------------------------------------------------------------------------
# PRODUCTION  (Vercel project env vars, Production scope — NOT in this repo)
# -----------------------------------------------------------------------------
# Production stays on Turso (libSQL) and evolves through Payload migrations
# that run at build time (guarded on VERCEL_ENV=production). Blob storage is
# enabled here only (gated in src/utilities/blobStorage.ts).

# Turso libSQL connection + auth.
DATABASE_URL=libsql://<your-turso-db>.turso.io
DATABASE_AUTH_TOKEN=<turso-auth-token>

# Production secret (distinct from the dev secret).
PAYLOAD_SECRET=<production-secret>

# Vercel Blob (the plugin enables only when VERCEL_ENV=production).
BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>
BLOB_STORE_ID=<vercel-blob-store-id>

# Cron + preview secrets.
CRON_SECRET=<cron-secret>
PREVIEW_SECRET=<preview-secret>

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set automatically by Vercel on deployments. Do NOT set it in local `.env` —
# its absence is what disables blob storage in development.
# VERCEL_ENV=production
